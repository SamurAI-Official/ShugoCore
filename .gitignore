# Byte-compiled / cache
__pycache__/
*.py[cod]

# Runtime artifacts
*.log
chroma_db/

# Local memory databases
*.db
*.sqlite3

# Audit / ledger artifacts (append-only runtime state)
audit_chain.jsonl
tier3_ledger.jsonl
*.jsonl

# Environments
.venv/
venv/

# OS / IDE
.DS_Store
.idea/
.vscode/
build/
dist/
*.egg-info/
.llama_build/

# Native build outputs packaged from CMake (see cpp/CMakeLists.txt):
# ONNX Runtime AAR extraction, and the mesh RPC peripheral executable that
# CMake writes into jniLibs so Gradle ships it as lib*.so.
platforms/android/app/src/main/cpp/onnxruntime/
platforms/android/app/src/main/jniLibs/

# Android (machine-specific SDK path + generated build outputs)
local.properties
platforms/android/app/build/
platforms/android/.gradle/
platforms/android/build/
.gradle/
.cxx/
*.apk
*.aab

# ONNX Runtime for Android is extracted from the official Maven AAR by
# scripts/fetch_ort_android.sh at build time (~19-23 MB per ABI; regenerate,
# don't commit). The C headers come from the same AAR so they always match.
platforms/android/app/src/main/cpp/onnxruntime/include/
platforms/android/app/src/main/cpp/onnxruntime/lib/

# Godot editor/import/export caches and generated Android export files
platforms/godot/.godot/
platforms/godot/android/
platforms/godot/*.bak*
platforms/godot/*.state_backup
nohup.out
